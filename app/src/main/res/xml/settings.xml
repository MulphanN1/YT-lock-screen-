<?xml version="1.0" encoding="utf-8"?>
<!-- Keys and defaults must match Prefs.kt. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/settings_playback">

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="ambient"
            app:summary="@string/settings_ambient_summary"
            app:title="@string/settings_ambient" />

        <SeekBarPreference
            android:max="100"
            app:defaultValue="55"
            app:dependency="ambient"
            app:iconSpaceReserved="false"
            app:key="ambient_strength"
            app:min="10"
            app:seekBarIncrement="5"
            app:showSeekBarValue="true"
            app:title="@string/settings_ambient_strength" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="low_quality_background"
            app:summary="@string/settings_low_quality_summary"
            app:title="@string/settings_low_quality" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="resume_playback"
            app:summary="@string/settings_resume_summary"
            app:title="@string/settings_resume" />
    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/settings_skip">

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="sponsorblock"
            app:summary="@string/settings_sponsorblock_summary"
            app:title="@string/settings_sponsorblock" />

        <MultiSelectListPreference
            app:defaultValue="@array/sponsor_categories_default"
            app:dependency="sponsorblock"
            app:entries="@array/sponsor_categories_names"
            app:entryValues="@array/sponsor_categories_values"
            app:iconSpaceReserved="false"
            app:key="sponsorblock_categories"
            app:title="@string/settings_sponsorblock_categories" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="ad_block"
            app:summary="@string/settings_ad_block_summary"
            app:title="@string/settings_ad_block" />
    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/settings_quick_access">

        <Preference
            app:iconSpaceReserved="false"
            app:key="add_widget"
            app:summary="@string/settings_widget_summary"
            app:title="@string/settings_widget" />

        <Preference
            app:iconSpaceReserved="false"
            app:key="add_tile"
            app:summary="@string/settings_tile_summary"
            app:title="@string/settings_tile" />
    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/settings_diagnostics">

        <Preference
            app:iconSpaceReserved="false"
            app:key="crash_log"
            app:summary="@string/settings_crash_log_summary"
            app:title="@string/settings_crash_log" />
    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/settings_about">

        <Preference
            app:iconSpaceReserved="false"
            app:key="version"
            app:selectable="false"
            app:title="@string/app_name" />

        <Preference
            app:iconSpaceReserved="false"
            app:title="@string/settings_privacy">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="https://github.com/MulphanN1/YT-lock-screen-/blob/main/PRIVACY.md" />
        </Preference>

        <Preference
            app:iconSpaceReserved="false"
            app:title="@string/settings_source">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="https://github.com/MulphanN1/YT-lock-screen-" />
        </Preference>
    </PreferenceCategory>
</PreferenceScreen>
